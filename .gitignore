__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Fetched and built audio is not committed…
samples/
build/
*.wav

# …except loops/ and strokes/, which the published site serves. Small
# (3.3 MB of loops, 5.2 MB of one-shots), derived from CC0 source, and without
# them there is no player to link to. Note the directories themselves must not
# be ignored, or the re-includes below could not reach into them.
!loops/*.wav
!strokes/*.wav
tmp/
vendor/
.playwright-mcp/
